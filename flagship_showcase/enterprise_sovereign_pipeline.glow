# GlowLang Native Modules Showcase
# Five natives implemented in C inside the runtime, used together in one
# small pipeline: JSON, BLAKE3, INT4 weights, socket polling and PNG headers.
#
# Run:  glowlang run enterprise_sovereign_pipeline.glow

use "tensor_utils.glow"

show "=== GlowLang Native Modules Pipeline ==="

# 1. Parse a transaction (json.parse builds dicts and lists).
let raw = '{"txn": "SOV-8821", "amount": 1000000}'
let txn = json.parse(raw)
show f"[1] Transaction {txn['txn']} for {txn['amount']}"

# json.scan_fast is a lighter helper: it returns only the first key and the
# raw text of its value, without parsing the rest.
let first = json.scan_fast(raw)
show f"    First field: {first['key']} = {first['val']}"

# 2. Seal it with a BLAKE3 hash (256-bit, 64 hex digits).
let seal = crypto.blake3(json.stringify(txn))
show "[2] BLAKE3 seal:", seal

# 3. INT4 weights: each element holds one byte packing two 4-bit weights.
let packed = tensor.zeros(2)
tensor.set(packed, 0, 163)
tensor.set(packed, 1, 127)
let weights = tensor.dequantize_int4(packed)
show "[3] Dequantized weights:", weights, "sum:", tensor_sum(weights, len(weights))

# 4. Check a listening socket for waiting connections (select-based).
let server = http.listen(0)
show "[4] Connection waiting:", net_fast.poll_fast(server, 10)
http.close(server)

# 5. Read the size of a PNG image from its first 24 header bytes.
let header = tensor.zeros(24)
let png_signature = [137, 80, 78, 71, 13, 10, 26, 10]
for each i, byte in png_signature:
    tensor.set(header, i, byte)
end
tensor.set(header, 18, 7)     # width  = 7 * 256 + 128 = 1920
tensor.set(header, 19, 128)
tensor.set(header, 22, 4)     # height = 4 * 256 + 56 = 1080
tensor.set(header, 23, 56)
let size = media.png_dims(header)
show f"[5] Image size: {size['width']} x {size['height']}"

show "Pipeline complete."

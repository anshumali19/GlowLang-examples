# JSON Example
# Parsing and producing JSON with the built-in `json` module, plus path
# queries and pretty-printing from the `json` package.
#
# Setup:  gdu install json
# Run:    glowlang run app.glow

use "json"

let text = '{"name": "GlowLang", "fast": true, "tags": ["natural", "jit"], "owner": {"country": "India"}}'
let data = json.parse(text)

show "Name:", data["name"]
when "tags" is in data:
    show "Tags:", ", ".join(data["tags"])
end

# Path queries from the json package.
let doc = jpath(data)
show "Country:", doc.get("owner.country")

# Build a value and turn it back into JSON.
data["version"] = 2
show "As JSON:", json.stringify(data)
show "Pretty:"
show json_pretty(data)
